DATABASE_URL=postgresql://postgres:postgres@db/mickeymouse_house
TEST_DATABASE_URL=postgresql://postgres:postgres@db/mickeymouse_house_test
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# ── Transactional email (app/services/email.py) ─────────────────────────────
# Default backend is "console" — magic-link / password-reset emails are just
# logged, so the whole onboarding flow works with zero provider setup. Set
# EMAIL_BACKEND=resend (with RESEND_API_KEY) or EMAIL_BACKEND=smtp (with
# SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD) to send for real.
APP_BASE_URL=http://localhost:5173
EMAIL_BACKEND=console
EMAIL_FROM=Mickeymouse House <no-reply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# ── Stripe studio billing: the platform's own revenue ────────────────────────
# Studios pay a recurring monthly subscription. Dormant until BILLING_ENABLED
# is truthy AND STRIPE_SECRET_KEY is set — left blank the feature simply isn't
# offered (GET /api/admin/billing/config -> {enabled:false}), it never 500s.
# Going live: create the Stripe account, set these, and register the webhook
# endpoint (POST /api/webhooks/stripe/billing) in the Stripe dashboard, whose
# signing secret is STRIPE_WEBHOOK_SECRET.
BILLING_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Copy this file to .env and fill in your own values.
# Never commit the real .env — see .gitignore.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@db/mickeymouse
TEST_DATABASE_URL=postgresql://postgres:postgres@db/mickeymouse_test

# Connection pool sizing (defaults are fine for local dev)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# --- Auth -----------------------------------------------------------------
# Any random string in dev. MUST be a real secret in production — the app
# refuses to boot with the default value when APP_ENV=production.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- App -------------------------------------------------------------------
# development | production — gates dev-only guards and default secrets.
APP_ENV=development
# Base URL the backend uses to build links (password reset, checkout
# redirects, etc). Point this at your frontend dev server / deployed URL.
APP_BASE_URL=http://localhost:5173

# --- Stripe billing ---------------------------------------------------------
# Leave blank to run with billing off (dormant, not erroring) — every
# billing endpoint reports "not enabled" until both a flag and a key are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Consumed by the frontend (Stripe Checkout / Elements); safe to expose.
STRIPE_PUBLISHABLE_KEY=

# --- Transactional email ----------------------------------------------------
# console (default) just logs the message — invites, password resets, and
# report links all work with zero provider setup. Switch the backend and add
# its secrets to send real mail; no code change needed either way.
EMAIL_BACKEND=console
EMAIL_FROM=
# EMAIL_BACKEND=resend
RESEND_API_KEY=
# EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
